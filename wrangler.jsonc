{
  "name": "neon-rift-racers",
  "compatibility_date": "2026-09-28",
  "main": "src/online-worker.js",
  "durable_objects": {
    "bindings": [{ "name": "RACE_ROOMS", "class_name": "RaceRoom" }]
  },
  "migrations": [{ "tag": "online-v1", "new_sqlite_classes": ["RaceRoom"] }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
