{
  "name": "neon-rift-racers",
  "private": true,
  "version": "0.1.0",
  "description": "Neon Rift Racers — Break the track. Rule the rift.",
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner",
    "dev:server": "wrangler dev --port 8787",
    "build": "tsc && vite build --configLoader runner",
    "smoke": "node scripts/smoke.mjs",
    "preview": "vite preview --configLoader runner",
    "test": "vitest run --configLoader runner",
    "test:watch": "vitest --configLoader runner",
    "test:e2e": "playwright test",
    "lint": "eslint src --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.50.0",
    "@types/three": "^0.170.0",
    "eslint": "^9.0.0",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.146.0"
  }
}
